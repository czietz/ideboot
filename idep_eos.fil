;*******************************************************************************
;* IDE Autoboot: KAOS/EOS dated September 12, 1995 boots from IDE master 0.
;* Copyright (c) 2025, Christian Zietz <czietz@gmx.net>
;* Command file for TOSPATCH.TTP.

;*******************************************************************************
;* KAOS/EOS dated September 12, 1995

.BASE   = FC0000    ;TOS ROM address
.LENGTH =  30000    ;TOS length
.WIDTH  =    .16    ;TOS ROM width

;*******************************************************************************
;* Input file

<KAOS.FC            ;Read unpatched ROM image from this file         <=== MODIFY
;<*                 ;Read ROM from the Atari.           <=== UNCOMMENT IF WANTED

/''
/'Cannot automatically check build date.'
/'This patch only works with KAOS/EOS dated September 12, 1995.'
/'Check the build date shown in the KAOS/EOS setup screen!'
/''

;*******************************************************************************
;* Output file(s)

>1        ; single TOS ROM image file (TOS.IMG).           <=== MODIFY AS NEEDED
;>2        ; 2 TOS ROM image files (TOS.LO/HI).            <=== MODIFY AS NEEDED
;>6        ; 6 TOS ROM image files (TOS.LO?/HI?).          <=== MODIFY AS NEEDED

;****************** DO NOT MODIFY ANYTHING BELOW THIS LINE ;********************
;*******************************************************************************
;* IDE Autoboot

CC0 $4E,B9,2FE26+.BASE.L,4E,71   ; JSR ideboot.  NOP.
CCA $4E,B9,2FE34+.BASE.L,4E,71   ; JSR kaosswap. NOP.
13A2 $2FE00+.BASE.L              ; dmaread into disp. table
2FE00 IDEB_EOS.BIN               ; the actual code
